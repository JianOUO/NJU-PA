# Sanity check
# 检查当前环境是否配置了正确的 NEMU 项目路径，如果检查失败则报错并停止编译。
# ifeq：Makefile 的条件判断语句 
# $(wildcard ...)：通配符函数，检查文件是否存在
# $(NEMU_HOME)/src/nemu-main.c：要检查的文件路径 
# , : ifeq 的参数分隔符
# 空字符串 : 如果文件不存在，wildcard 返回空
# $(error ...)：Makefile 的错误输出函数，会停止执行
# 错误信息：显示具体的错误信息和当前 NEMU_HOME 的值
# endif：结束条件判断语句
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# Include variables and rules generated by menuconfig
# 整体功能：将图形化配置界面 (menuconfig) 的选择结果集成到 Makefile 编译系统中，实现可配置的模块化编译。
# - : 如果文件不存在，不报错，继续执行
# include: 包含指定的 Makefile 文件
# 第一次编译前：用户还没运行 menuconfig，文件不存在 
# 使用 -include：不会报错，继续执行（通常会提示用户先配置）
# 配置后：文件存在，正常包含配置
# 这些是 make menuconfig 后自动生成的文件。
# auto.conf: 配置变量定义,这个文件包含用户在 menuconfig 中选择的配置，以 Makefile 变量形式存储
# auto.conf.cmd: 这个文件记录配置变量的依赖关系和验证信息
-include $(NEMU_HOME)/include/config/auto.conf
-include $(NEMU_HOME)/include/config/auto.conf.cmd

# 这个函数的作用是：移除字符串开头和结尾的双引号。
# remove_quote = ... 定义了一个名为 remove_quote 的变量（在 Makefile 中可作为函数使用）
# $(1) 表示函数的第一个参数
# $(patsubst pattern,replacement,text) 模式替换函数：在文本中查找模式并替换
# 参数: 
# pattern：要查找的模式 "%"
# replacement：替换内容 %
# text：要处理的文本 $(1)
# patsubst "%",%,...
# 查找模式："%" → 匹配双引号包裹的任何内容
# 替换为：% → 只保留内容，去掉双引号
# 这种函数通常用于处理从配置文件或外部工具获取的字符串
# 从 menuconfig 获取的配置可能带引号
remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
# ?=：条件赋值（Conditional Assignment）
# 作用：如果变量已经定义，则保持原值；如果未定义，则赋予新值
# ?= 允许用户在命令行覆盖默认值
# 例如 make GUEST_ISA=x86 即使menuconfig选择了riscv32，也可以临时覆盖
# =：递归展开赋值, 每次使用时都会重新展开变量值
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

# Include all filelist.mk to merge file lists
# $(shell ...)：在 shell 中执行命令，并将结果赋值给 FILELIST_MK
# -L：跟随符号链接,如果遇到符号链接，会进入链接指向的实际目录进行查找
# ./src：从 src 目录开始查找
# find -L ./src -name "filelist.mk"：查找 src 目录下所有 filelist.mk 文件
# include $(FILELIST_MK)：包含所有 filelist.mk 文件
# 每个 filelist.mk 定义自己模块的源文件列表和目录列表
# 执行 include $(FILELIST_MK) 后，所有变量被合并到主 Makefile 中
# 优点：模块化 每个目录管理自己的文件列表，新增模块只需添加对应的 filelist.mk，不需要修改主 Makefile
FILELIST_MK = $(shell find -L ./src -name "filelist.mk")
include $(FILELIST_MK)

# Filter out directories and files in blacklist to obtain the final set of source files
# 这里的DIRS-BLACKLIST和SRCS-BLACKLIST是filelist.mk中定义的变量
# 第一步: 将通用的 DIRS-BLACKLIST 合并到条件黑名单 DIRS-BLACKLIST-y 中
# 第二步: 生成完整的源文件黑名单
# 第一部分：$(SRCS-BLACKLIST) - 直接指定的黑名单文件
# 第二部分：$(shell find -L $(DIRS-BLACKLIST-y) -name "*.c") - 查找黑名单目录中的所有 .c 文件
# 结果：SRCS-BLACKLIST-y 包含所有需要排除的源文件
# 第三步: 发现所有候选源文件
# 作用：在 DIRS-y 指定的目录中递归查找所有 .c 文件
# 结果：SRCS-y 包含所有可能的源文件（包括需要排除的）
# 第四步：过滤出最终源文件
# $(filter-out pattern...,text): 从text中移除所有匹配pattern的元素
# $(filter-out bad1.c bad2.c, file1.c bad1.c file2.c bad2.c)
# 结果: file1.c file2.c
# 作用：从所有源文件中移除黑名单文件，得到最终需要编译的文件
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST) $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c")
SRCS-y += $(shell find -L $(DIRS-y) -name "*.c")
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

# Extract compiler and options from menuconfig
# CC指编译器，ifneq ($(CONFIG_CC),)：如果 CONFIG_CC 不为空
# 允许用户通过菜单配置覆盖默认编译器
ifneq ($(CONFIG_CC),)
CC = $(call remove_quote,$(CONFIG_CC))
endif
# CONFIG_CC_OPT：用户选择的基本优化选项（如 -O2）
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
# $(if condition,then,else)：Makefile 的条件函数
# LTO：链接时优化（减少最终代码大小）
# 如果 CONFIG_CC_LTO 被设置，添加 -flto 标志
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
# -Og：优化级别，适合调试 -ggdb3：生成 GDB 调试信息（级别3）
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
# -fsanitize=address：AddressSanitizer，检测内存错误
# 在调试时检测内存越界、使用释放内存等问题
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)
# -DITRACE_COND=...：定义预处理器宏
# 相当于在C代码中写 #define ITRACE_COND condition
# 作用：设置指令追踪的启用条件
# 默认：如果未配置，默认为 true（总是启用）
CFLAGS_TRACE += -DITRACE_COND=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true)
# CFLAGS：C 编译器标志
# LDFLAGS：链接器标志
# -D__GUEST_ISA__=$(GUEST_ISA)：定义目标 ISA 的宏

CFLAGS  += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += $(CFLAGS_BUILD)

# 添加 -save-temps=obj 保存预处理文件到 build/obj-* 目录
# 注释掉下面这行可以禁用
CFLAGS_BUILD += -save-temps=obj

# Include rules for menuconfig
include $(NEMU_HOME)/scripts/config.mk

# ARCHIVES：AM 定义的静态库文件（如 libam.a）
# LINKAGE：最终链接时使用的库文件列表
# 作用：将 AM 的运行时库链接到 NEMU 中
ifdef CONFIG_TARGET_AM
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Include rules to build NEMU
include $(NEMU_HOME)/scripts/native.mk
endif
